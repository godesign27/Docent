{
  "name": "docent",
  "version": "0.1.0",
  "description": "A reusable concierge layer that lets engineering agents safely query any enterprise design system.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "docent": "./bin/docent.js"
  },
  "scripts": {
