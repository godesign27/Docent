    "tinyglobby": "^0.2.15",
    "typescript": "~5.9.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
