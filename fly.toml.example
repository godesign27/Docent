# `npm run docent -- bundle --client <id>` writes this as fly.toml in .deploy/<id>, then from there:
#   fly apps create docent-<id>
#   fly volumes create docent_logs --size 1 --region <region> --app docent-<id>
#   fly secrets set DOCENT_TOKEN=$(openssl rand -hex 32) --stage --app docent-<id>
#   fly deploy
app = "docent-CLIENT-ID"
primary_region = "iad"

# Docent runs through tsx and holds the contract and source snapshot in memory: about 400 MB
# at startup. Fly's default 256 MB machine is killed before it listens.
[[vm]]
  size = "shared-cpu-1x"
  memory = "1gb"

[env]
  DOCENT_CLIENT = "CLIENT-ID"
  PORT = "8080"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    method = "GET"
    path = "/healthz"
    interval = "30s"
    timeout = "5s"
    grace_period = "10s"

[mounts]
  source = "docent_logs"
  destination = "/app/logs"
