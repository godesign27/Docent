# Copy to fly.toml in the clone that serves this client, then:
#   fly launch --no-deploy --copy-config
#   fly volumes create docent_logs --size 1
#   fly secrets set DOCENT_TOKEN=$(openssl rand -hex 32)
#   fly deploy
app = "docent-CLIENT-ID"
primary_region = "iad"

[env]
  DOCENT_CLIENT = "CLIENT-ID"
  PORT = "8080"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    method = "GET"
    path = "/healthz"
    interval = "30s"
    timeout = "5s"
    grace_period = "10s"

[mounts]
  source = "docent_logs"
  destination = "/app/logs"
