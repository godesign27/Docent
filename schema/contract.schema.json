{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.5.0"
    },
    "docentVersion": {
      "type": "string"
    },
    "client": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "local",
            "git"
          ]
        },
        "location": {
          "type": "string"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "subdir": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "location",
        "ref",
        "commit",
        "subdir"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string"
    },
    "contentHash": {
      "type": "string",
      "description": "sha256 of the contract body excluding generatedAt; changes only when the extracted design system changes"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable slug derived from the source file name"
          },
          "name": {
            "type": "string"
          },
          "importPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "importPathSource": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "manifest",
                  "config",
                  "tsconfig-paths"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Exported identifier, e.g. CardHeader"
                },
                "primary": {
                  "type": "boolean",
                  "description": "True for the part the module is named after"
                },
                "element": {
                  "description": "Rendered host element or primitive when statically visible",
                  "type": "string"
                },
                "props": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "description": "Type as written in source"
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "values": {
                        "description": "Allowed literal values, when the type is a closed set",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "default": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "declared",
                          "variant"
                        ],
                        "description": "declared = written in a props type; variant = derived from a variant definition (e.g. cva)"
                      }
                    },
                    "required": [
                      "name",
                      "type",
                      "required",
                      "origin"
                    ],
                    "additionalProperties": false
                  }
                },
                "extends": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Types whose props are inherited but not expanded, e.g. React.ButtonHTMLAttributes<HTMLButtonElement>"
                },
                "variants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "default": {
                        "type": "string"
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string",
                            "description": "Path relative to the design-system root"
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "file"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "name",
                      "values",
                      "source"
                    ],
                    "additionalProperties": false
                  }
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "description": "Path relative to the design-system root"
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "file"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "primary",
                "props",
                "extends",
                "variants",
                "description",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "otherExports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Non-component value exports, e.g. buttonVariants"
          },
          "typeExports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exported TypeScript types and interfaces, e.g. ButtonProps"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "External packages imported by the component"
          },
          "tokenRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of design tokens referenced by the component's styles"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "heading": {
                  "type": "string"
                },
                "content": {
                  "type": "string",
                  "description": "Raw markdown of the matched section, unparsed"
                }
              },
              "required": [
                "file",
                "heading",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "manifest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "notes": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "description": "Path relative to the design-system root"
                      },
                      "line": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "file"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "status",
                  "category",
                  "notes",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "What the client's own component inventory says about this component, placeholders removed"
          },
          "guidance": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "description": "Path relative to the design-system root"
                      },
                      "line": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "file"
                    ],
                    "additionalProperties": false
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lifecycle": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "intent": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "forbiddenUsage": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "agentRules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "propHints": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Prop name -> authored usage hint"
                  },
                  "structure": {
                    "anyOf": [
                      {},
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Required nesting of compound parts, as authored"
                  },
                  "accessibility": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "experience": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "AI autonomy and accountability metadata, when declared"
                  },
                  "related": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "note": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "note"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "knownGaps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Limitations the client declared themselves"
                  }
                },
                "required": [
                  "source",
                  "id",
                  "lifecycle",
                  "category",
                  "intent",
                  "description",
                  "forbiddenUsage",
                  "agentRules",
                  "propHints",
                  "structure",
                  "accessibility",
                  "experience",
                  "related",
                  "knownGaps"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "install": {
            "type": "object",
            "properties": {
              "supportFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Non-component files this component needs, transitively (e.g. src/lib/utils.ts)"
              },
              "componentDependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ids of other components this one imports directly"
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "description": "Range from the design system's package.json; null when it is not declared there",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "dev": {
                      "type": "boolean",
                      "description": "Declared under devDependencies"
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "dev"
                  ],
                  "additionalProperties": false
                },
                "description": "npm packages imported by this component and its support files"
              }
            },
            "required": [
              "supportFiles",
              "componentDependencies",
              "packages"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "importPath",
          "importPathSource",
          "files",
          "parts",
          "otherExports",
          "typeExports",
          "dependencies",
          "tokenRefs",
          "description",
          "docs",
          "manifest",
          "guidance",
          "install"
        ],
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Name as authored, e.g. --primary or color.brand.primary"
          },
          "cssVariable": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "color",
              "dimension",
              "number",
              "fontFamily",
              "fontWeight",
              "duration",
              "cubicBezier",
              "shadow",
              "animation",
              "other",
              "unknown"
            ]
          },
          "typeEvidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "declared",
                  "tailwind-section",
                  "value-format",
                  "css-usage"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "color",
              "typography",
              "spacing",
              "radius",
              "elevation",
              "motion",
              "breakpoint",
              "layout",
              "other",
              "uncategorized"
            ]
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "raw": {
                  "type": "string",
                  "description": "Value exactly as written in source"
                },
                "format": {
                  "description": "Value encoding when known, e.g. hsl-channels",
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "description": "Path relative to the design-system root"
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "file"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "raw",
                "source"
              ],
              "additionalProperties": false
            },
            "description": "Keyed by mode, e.g. light / dark / default"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of tokens this token's value depends on"
          },
          "tailwind": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "string",
                  "description": "Tailwind theme section, e.g. colors, borderRadius"
                },
                "key": {
                  "type": "string",
                  "description": "Utility key, e.g. primary-foreground"
                },
                "exampleClasses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "description": "Path relative to the design-system root"
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "file"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "section",
                "key",
                "exampleClasses",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "description": {
            "description": "What the token means, from token JSON or the client's semantic token roles",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "description": "Semantic role group, e.g. surface, content, action",
            "type": [
              "string",
              "null"
            ]
          },
          "documented": {
            "description": "Whether token docs mention this token; null when no token docs are configured",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "cssVariable",
          "type",
          "typeEvidence",
          "category",
          "values",
          "references",
          "tailwind",
          "description",
          "role",
          "documented"
        ],
        "additionalProperties": false
      }
    },
    "sourceFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "role": {
            "type": "string",
            "enum": [
              "component",
              "support",
              "foundation"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "additionalProperties": false
      },
      "description": "Every file Docent may hand to a calling agent, with its hash at the ingested commit"
    },
    "foundation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Theme tokens, Tailwind/PostCSS config and other project-level files every component relies on"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "description": "Range from the design system's package.json; null when it is not declared there",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "dev": {
                    "type": "boolean",
                    "description": "Declared under devDependencies"
                  }
                },
                "required": [
                  "name",
                  "version",
                  "dev"
                ],
                "additionalProperties": false
              }
            },
            "pathAliases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alias": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                },
                "required": [
                  "alias",
                  "target"
                ],
                "additionalProperties": false
              },
              "description": "Import aliases the component source assumes, e.g. @/ -> src/"
            }
          },
          "required": [
            "files",
            "packages",
            "pathAliases"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tokenGuidance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "need": {
                    "type": "string"
                  },
                  "use": {
                    "type": "string"
                  }
                },
                "required": [
                  "need",
                  "use"
                ],
                "additionalProperties": false
              },
              "description": "Authored lookup from a styling need to the utilities to use"
            },
            "forbidden": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Path relative to the design-system root"
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "decisions",
            "forbidden",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "requiredComponents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Contract component ids"
          },
          "recommendedComponents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optionalComponents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unresolvedComponents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "References in the pattern that match no component in the contract"
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What the pattern requires"
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What the pattern forbids"
          },
          "example": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Additional authored fields kept verbatim, e.g. aiBehavior"
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "description": "Path relative to the design-system root"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "intent",
          "requiredComponents",
          "recommendedComponents",
          "optionalComponents",
          "unresolvedComponents",
          "sequence",
          "rules",
          "forbidden",
          "example",
          "metadata",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "unspecified"
                ]
              },
              "category": {
                "type": "string"
              },
              "response": {
                "description": "What the client wants an agent told when this rule is hit",
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference": {
