node_modules/
.DS_Store
*.log

# Local clones of client repos made during ingestion
.docent/

# Generated per-client output. Client contracts and audit logs never live in
# the core repo — that keeps one client's data out of every other clone.
contracts/*
!contracts/README.md
logs/*
!logs/README.md

.env
.env.*

# Client configs stay in the clone that serves that client. The core repo only
# carries the template and the reference client (GO Design's own design system).
config/clients/*
!config/clients/_template.yaml
!config/clients/agentic-ui-shadcn.yaml
!config/clients/agentic-ui-shadcn.eval.yaml
